# Токен бота от @BotFather. НИКОГДА не коммитить.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Username бота без @ (для подсказок и ссылок).
BOT_USERNAME=deanery_demo_bot

# URL мини-аппа (в dev — Vite на 5173, в проде — твой домен).
WEBAPP_URL=http://localhost:5173

# Порт API.
PORT=3000

# Максимальный возраст initData в секундах (защита от повтора).
AUTH_MAX_AGE=86400

# tg_id владельцев/сотрудников через запятую (получают роль owner).
ADMIN_TG_IDS=

# DEV=true включает обход авторизации для локальной отладки без Telegram.
DEV=false
