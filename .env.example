# Секрет для подписи cookie-сессий. Сгенерируйте свой: python -c "import secrets;print(secrets.token_hex(32))"
SECRET=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=8080
DB_PATH=storage/deanery.db
TZ_NAME=Europe/Moscow
# Понедельник первой учебной недели семестра (от него считается чётность)
SEMESTER_START=2026-08-31
# 1 — cookie только по HTTPS. В продакшене обязательно 1
COOKIE_SECURE=0
